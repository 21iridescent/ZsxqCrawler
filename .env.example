# Primary research-report classifier.
# Leave keys empty in this file. Put real values in .env, which is not committed.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter fallback when DeepSeek fails (HTTP 402 / insufficient balance,
# auth errors, and similar hard failures).
# Model in use: minimax/minimax-m3.1-flash
# minimax/minimax-m3.1-flash:free was requested but returns HTTP 404
# (retired / unavailable). Do not append :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
